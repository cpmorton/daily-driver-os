#!/usr/bin/bash
# Import a DDSEED provisioning volume, once, at first boot.
#
# The installer ISO is public and generic; everything machine- or
# person-specific comes from a FAT32/exFAT volume labelled DDSEED (a second USB
# stick, or a second partition), prepared on Windows with
# tools/windows/New-DailyDriverSeed.ps1. Layout, under daily-driver-seed/:
#
#   seed.json              {"version":1, "hostname":"..."}
#   users/<name>.json      {"userName":"<name>", "realName":"...", "diskSize":<bytes>}
#   skel/localadmin/...    copied into localadmin's home
#   skel/<name>/...        copied into <name>'s new encrypted home
#
# No passwords: every password is typed on the console at first boot
# (localadmin-firstboot.service, then first-users). User records are rebuilt
# from an allowlist of the three fields above, so a stick can't carry a
# password (secret), group membership (memberOf) or any other field into the
# record; anything else is logged and dropped. Records are staged in
# /run/daily-driver/users (RAM) for daily-driver-users.service, and the seed
# directory is deleted from the stick once imported, since skel folders may hold
# private files.
# See docs/decisions/0018-provisioning-seed-stick.md and
# docs/decisions/0019-no-seeded-passwords.md.
set -euo pipefail

ROOT="${SEED_ROOT:-}" # test seam: prefixes every path this script writes
readonly LABEL=DDSEED
readonly STATE="${ROOT}/var/lib/daily-driver"
readonly USERS_STAGE="${ROOT}/run/daily-driver/users"
readonly SKEL_STAGE_PATH=/run/daily-driver/skel # as homed will see it
readonly SKEL_STAGE="${ROOT}${SKEL_STAGE_PATH}"
readonly NAME_RE='^[a-z_][a-z0-9_-]{0,31}$'

log() { echo "daily-driver-seed: $*"; }
die() {
	echo "daily-driver-seed: ERROR: $*" >&2
	exit 1
}

mountpoint=""
# shellcheck disable=SC2329 # invoked by the EXIT trap
cleanup() {
	if [[ -n "${mountpoint}" ]]; then
		sync
		umount "${mountpoint}" 2>/dev/null || true
		rmdir "${mountpoint}" 2>/dev/null || true
	fi
}
trap cleanup EXIT

finish() {
	mkdir -p "${STATE}"
	touch "${STATE}/seed-imported"
	exit 0
}

# --- Find the seed ------------------------------------------------------------
if [[ -n "${SEED_DIR:-}" ]]; then
	seed="${SEED_DIR}"
else
	udevadm settle --timeout=10 || true
	device="/dev/disk/by-label/${LABEL}"
	for _ in 1 2 3 4 5; do
		[[ -e "${device}" ]] && break
		sleep 1
	done
	if [[ ! -e "${device}" ]]; then
		log "no ${LABEL} volume; nothing to import"
		finish
	fi
	mountpoint="$(mktemp -d /run/daily-driver-seed.XXXXXX)"
	mount -o rw,nosuid,nodev,noexec "${device}" "${mountpoint}" ||
		die "can't mount ${device}"
	seed="${mountpoint}/daily-driver-seed"
fi
if [[ ! -d "${seed}" ]]; then
	log "${LABEL} has no daily-driver-seed/ directory; nothing to import"
	finish
fi
log "importing ${seed}"

# --- Validate everything before changing anything -----------------------------
config="${seed}/seed.json"
hostname=""
if [[ -f "${config}" ]]; then
	jq -e '.version == 1' "${config}" >/dev/null || die "seed.json: missing or unsupported \"version\""
	hostname="$(jq -r '.hostname // empty' "${config}")"
	if [[ -n "${hostname}" && ! "${hostname}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]]; then
		die "seed.json: invalid hostname '${hostname}'"
	fi
	# An older stick may carry localadmin.hashedPassword or SSH keys: never applied.
	extra="$(jq -r 'keys - ["version", "hostname"] | join(", ")' "${config}")"
	[[ -z "${extra}" ]] || log "seed.json: ignoring ${extra} (passwords are typed at first boot; decision 0019)"
fi

users=()
for record in "${seed}"/users/*.json; do
	[[ -e "${record}" ]] || continue
	name="$(basename "${record}" .json)"
	[[ "${name}" =~ ${NAME_RE} ]] || die "users/${name}.json: invalid user name"
	[[ "${name}" != localadmin ]] || die "users/localadmin.json: localadmin is not a homed user"
	jq -e --arg n "${name}" '.userName == $n' "${record}" >/dev/null ||
		die "users/${name}.json: userName must be \"${name}\""
	jq -e '(.realName // "" | type == "string") and (.diskSize // 10737418240 | type == "number" and . >= 10737418240)' \
		"${record}" >/dev/null || die "users/${name}.json: realName must be text, diskSize a number of bytes, 10 GiB or more"
	users+=("${name}")
done

# --- Apply -------------------------------------------------------------------
if [[ -n "${hostname}" ]]; then
	printf '%s\n' "${hostname}" >"${ROOT}/etc/hostname"
	log "hostname: ${hostname}"
fi

if [[ -d "${seed}/skel/localadmin" ]]; then
	home="${ROOT}/var/home/localadmin"
	mkdir -p "${home}"
	cp -a "${seed}/skel/localadmin/." "${home}/"
	chown -R localadmin:localadmin "${home}"
	restorecon -RF "${home}" 2>/dev/null || true
	log "localadmin: skel copied"
fi

if ((${#users[@]})); then
	(umask 077 && mkdir -p "${USERS_STAGE}" "${SKEL_STAGE}")
	for name in "${users[@]}"; do
		record="${seed}/users/${name}.json"
		extra="$(jq -r 'keys - ["userName", "realName", "diskSize"] | join(", ")' "${record}")"
		[[ -z "${extra}" ]] || log "users/${name}.json: ignoring ${extra}"
		skeleton=""
		if [[ -d "${seed}/skel/${name}" ]]; then
			cp -a "${seed}/skel/${name}" "${SKEL_STAGE}/${name}"
			skeleton="${SKEL_STAGE_PATH}/${name}"
		fi
		# Allowlist: only these fields reach homectl.
		(umask 077 && jq --arg skel "${skeleton}" '
			{userName, storage: "luks"}
			+ (if has("realName") then {realName} else {} end)
			+ (if has("diskSize") then {diskSize} else {} end)
			+ (if $skel != "" then {skeletonDirectory: $skel} else {} end)' \
			"${record}" >"${USERS_STAGE}/${name}.json")
		log "user ${name}: staged; the console asks for the password"
	done
fi

# --- Consume the seed: skel folders may hold private files -------------------
rm -rf "${seed}"
if [[ -n "${mountpoint}" ]]; then
	printf 'Imported by %s on %s. The seed was deleted from this stick.\n' \
		"${hostname:-this machine}" "$(date -Is)" >"${mountpoint}/IMPORTED.txt"
fi
log "done; seed deleted from the stick"
finish
