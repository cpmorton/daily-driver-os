#!/usr/bin/bash
# Create the first daily users, once, before the login screen.
#   - Seeded users: `homectl firstboot` creates one encrypted home per
#     home.create.<name> credential that seed-import staged.
#   - No seed: ask on the console, one user at a time.
# Either way, every homed user gets subordinate IDs for rootless podman.
# See docs/decisions/0018-provisioning-seed-stick.md.
set -euo pipefail

readonly NAME_RE='^[a-z_][a-z0-9_-]{0,31}$'
ROOT="${USERS_ROOT:-}" # test seam: prefixes every path this script writes
LIBEXEC="${LIBEXEC:-/usr/libexec/daily-driver}"

seeded=0
if [[ -n "${CREDENTIALS_DIRECTORY:-}" ]] && compgen -G "${CREDENTIALS_DIRECTORY}/home.create.*" >/dev/null; then
	seeded=1
fi

if ((seeded)); then
	# The documented first-boot path for home.create.* credentials. OVERRIDE=0
	# turns its own interactive prompt off.
	SYSTEMD_HOME_FIRSTBOOT_OVERRIDE=0 homectl firstboot
elif [[ -z "$(homectl list --no-legend 2>/dev/null)" ]]; then
	echo
	echo "=== Create the first user account ==="
	echo "Each account's home is encrypted with its own password;"
	echo "localadmin can't open it."
	while :; do
		read -rp "Username (lowercase, e.g. chris): " name
		if [[ ! "${name}" =~ ${NAME_RE} || "${name}" == localadmin ]]; then
			echo "Not a valid new username."
			continue
		fi
		read -rp "Full name: " real
		read -rp "Home size in GB [100]: " size
		size="${size:-100}"
		if [[ ! "${size}" =~ ^[0-9]+$ ]]; then
			echo "Size must be a whole number of GB."
			continue
		fi
		# homectl asks for the password itself, twice.
		if homectl create "${name}" --real-name="${real}" --storage=luks --disk-size="${size}G"; then
			echo "Created ${name}."
		else
			echo "Creating ${name} failed; try again."
			continue
		fi
		read -rp "Create another user? [y/N] " again
		[[ "${again}" =~ ^[Yy] ]] || break
	done
fi

"${LIBEXEC}/ensure-subids"
rm -f "${ROOT}"/run/credstore/home.create.* 2>/dev/null || true
rm -rf "${ROOT}/run/daily-driver/skel" 2>/dev/null || true
mkdir -p "${ROOT}/var/lib/daily-driver"
touch "${ROOT}/var/lib/daily-driver/users-created"
