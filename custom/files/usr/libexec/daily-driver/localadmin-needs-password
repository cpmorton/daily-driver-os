#!/usr/bin/bash
# ExecCondition for localadmin-firstboot.service: exit 0 (ask for a password)
# only while localadmin's password is still locked or empty, as sysusers.d
# creates it. An account that already has a password (an existing install
# switched to this image) is left alone. Any other exit status skips the prompt.
set -euo pipefail
status="$(passwd -S localadmin 2>/dev/null | awk '{print $2}')"
case "${status}" in
L | LK | NP) exit 0 ;;
*) exit 1 ;;
esac
