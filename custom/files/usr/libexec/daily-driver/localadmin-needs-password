#!/usr/bin/bash
# ExecCondition for localadmin-firstboot.service: exit 0 (ask for a password)
# only while localadmin's password is still locked or empty, i.e. when no
# seed stick provided one. Any other exit status skips the prompt.
set -euo pipefail
status="$(passwd -S localadmin 2>/dev/null | awk '{print $2}')"
case "${status}" in
L | LK | NP) exit 0 ;;
*) exit 1 ;;
esac
