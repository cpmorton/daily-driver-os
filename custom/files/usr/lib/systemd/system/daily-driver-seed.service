# First boot, step 1: import a DDSEED provisioning stick if one is plugged in.
# Order: sysusers -> localadmin-home -> this -> localadmin-firstboot
#        -> daily-driver-users -> login screen.
# See docs/decisions/0018-provisioning-seed-stick.md.
[Unit]
Description=Import a DDSEED provisioning stick (first boot)
ConditionPathExists=!/var/lib/daily-driver/seed-imported
After=systemd-sysusers.service localadmin-home.service systemd-udev-settle.service local-fs.target
Before=localadmin-firstboot.service daily-driver-users.service gdm.service display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/daily-driver/seed-import

[Install]
WantedBy=multi-user.target
