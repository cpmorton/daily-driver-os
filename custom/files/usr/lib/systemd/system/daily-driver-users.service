# First boot, step 3: create the daily users on tty1. Names and home sizes come
# from the records seed-import staged, or are asked here; passwords are always
# typed here. See docs/decisions/0019-no-seeded-passwords.md.
[Unit]
Description=Create the first daily users (first boot, tty1)
ConditionPathExists=!/var/lib/daily-driver/users-created
Wants=systemd-homed.service
After=systemd-homed.service daily-driver-seed.service localadmin-firstboot.service systemd-user-sessions.service
Before=gdm.service display-manager.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=oneshot
TimeoutStartSec=infinity
ExecStartPre=-/usr/bin/plymouth quit
ExecStartPre=-/usr/bin/chvt 1
ExecStart=/usr/libexec/daily-driver/first-users
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
